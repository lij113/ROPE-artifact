{
  "version": "paper_v1_mcp_capture",
  "date": "2026-05-25",
  "output_root": "bench/mcp_traces/paper_v1",
  "profile_output": "bench/profiles/paper_v1/captured_tool_profiles.json",
  "servers": [
    {
      "server_id": "filesystem",
      "category": "file_knowledge",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/tmp/rope-mcp-sandbox"
      ],
      "setup": {
        "kind": "filesystem_sandbox",
        "root": "/tmp/rope-mcp-sandbox"
      },
      "sample_calls": [
        {
          "name": "list_directory",
          "arguments": {
            "path": "/tmp/rope-mcp-sandbox"
          }
        },
        {
          "name": "read_text_file",
          "arguments": {
            "path": "/tmp/rope-mcp-sandbox/private_customer_email.txt"
          }
        },
        {
          "name": "write_file",
          "arguments": {
            "path": "/tmp/rope-mcp-sandbox/local_draft.txt",
            "content": "Draft reply: thanks for the update."
          }
        }
      ]
    },
    {
      "server_id": "memory",
      "category": "persistent_memory",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "sample_calls": [
        {
          "name": "create_entities",
          "arguments": {
            "entities": [
              {
                "name": "ROPE paper",
                "entityType": "research_project",
                "observations": [
                  "Continuation safety is the central claim."
                ]
              }
            ]
          }
        },
        {
          "name": "search_nodes",
          "arguments": {
            "query": "ROPE"
          }
        }
      ]
    },
    {
      "server_id": "git",
      "category": "repo_developer_tool",
      "command": [
        "uvx",
        "mcp-server-git",
        "--repository",
        "/Users/openclaw/ROPE"
      ],
      "sample_calls": [
        {
          "name": "git_status",
          "arguments": {
            "repo_path": "/Users/openclaw/ROPE"
          }
        },
        {
          "name": "git_log",
          "arguments": {
            "repo_path": "/Users/openclaw/ROPE",
            "max_count": 3
          }
        }
      ]
    },
    {
      "server_id": "fetch",
      "category": "public_web",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "sample_calls": [
        {
          "name": "fetch",
          "arguments": {
            "url": "https://example.com",
            "max_length": 2000
          }
        }
      ]
    },
    {
      "server_id": "sqlite",
      "category": "local_database",
      "command": [
        "uvx",
        "--from",
        "mcp-server-sqlite",
        "mcp-server-sqlite",
        "--db-path",
        "/tmp/rope-mcp-sandbox/rope_capture.db"
      ],
      "setup": {
        "kind": "sqlite_db",
        "path": "/tmp/rope-mcp-sandbox/rope_capture.db"
      },
      "sample_calls": [
        {
          "name": "create_table",
          "arguments": {
            "query": "CREATE TABLE IF NOT EXISTS customers (id INTEGER PRIMARY KEY, email TEXT, note TEXT)"
          }
        },
        {
          "name": "write_query",
          "arguments": {
            "query": "INSERT INTO customers (email, note) VALUES ('alice@example.com', 'renewal draft only')"
          }
        },
        {
          "name": "read_query",
          "arguments": {
            "query": "SELECT email, note FROM customers LIMIT 5"
          }
        }
      ]
    },
    {
      "server_id": "github",
      "category": "external_repo_write",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "requires_env": [
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "GITHUB_TEST_OWNER",
        "GITHUB_TEST_REPO"
      ],
      "sample_calls": [
        {
          "name": "search_repositories",
          "arguments": {
            "query": "modelcontextprotocol",
            "perPage": 1
          }
        },
        {
          "name": "get_file_contents",
          "arguments": {
            "owner": "${ENV:GITHUB_TEST_OWNER}",
            "repo": "${ENV:GITHUB_TEST_REPO}",
            "path": "README.md",
            "branch": "main"
          }
        },
        {
          "name": "create_issue",
          "arguments": {
            "owner": "${ENV:GITHUB_TEST_OWNER}",
            "repo": "${ENV:GITHUB_TEST_REPO}",
            "title": "ROPE MCP capture write test {run_stamp}",
            "body": "Generated by ROPE paper-v1 GitHub MCP capture. This disposable issue validates external repo write handling."
          }
        },
        {
          "name": "push_files",
          "arguments": {
            "owner": "${ENV:GITHUB_TEST_OWNER}",
            "repo": "${ENV:GITHUB_TEST_REPO}",
            "branch": "main",
            "message": "ROPE MCP capture write test {run_stamp}",
            "files": [
              {
                "path": "rope-capture/write-test-{run_stamp}.md",
                "content": "# ROPE MCP Capture\n\nThis file was generated by a disposable GitHub MCP write test.\n"
              }
            ]
          }
        }
      ]
    },
    {
      "server_id": "slack",
      "category": "same_org_message",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "requires_env": [
        "SLACK_BOT_TOKEN",
        "SLACK_TEAM_ID",
        "SLACK_CHANNEL_ID"
      ],
      "sample_calls": [
        {
          "name": "slack_list_channels",
          "arguments": {
            "limit": 5
          }
        },
        {
          "name": "slack_get_channel_history",
          "arguments": {
            "channel_id": "${ENV:SLACK_CHANNEL_ID}",
            "limit": 5
          }
        },
        {
          "name": "slack_post_message",
          "arguments": {
            "channel_id": "${ENV:SLACK_CHANNEL_ID}",
            "text": "ROPE MCP capture Slack write test {run_stamp}"
          }
        }
      ]
    },
    {
      "server_id": "notion",
      "category": "document_workspace",
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "requires_env": [
        "NOTION_TOKEN",
        "NOTION_PAGE_ID"
      ],
      "sample_calls": [
        {
          "name": "API-retrieve-a-page",
          "arguments": {
            "page_id": "${ENV:NOTION_PAGE_ID}"
          }
        },
        {
          "name": "API-get-block-children",
          "arguments": {
            "block_id": "${ENV:NOTION_PAGE_ID}",
            "page_size": 5
          }
        },
        {
          "name": "API-patch-block-children",
          "arguments": {
            "block_id": "${ENV:NOTION_PAGE_ID}",
            "children": [
              {
                "type": "paragraph",
                "paragraph": {
                  "rich_text": [
                    {
                      "type": "text",
                      "text": {
                        "content": "ROPE MCP capture Notion write test {run_stamp}"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "server_id": "google_drive",
      "category": "cloud_document_storage",
      "command": [
        ".venv/bin/python",
        "scripts/gdrive_service_account_mcp.py"
      ],
      "requires_env": [
        "GOOGLE_DRIVE_TEST_FOLDER_ID"
      ],
      "requires_one_of_env": [
        [
          "GOOGLE_OAUTH_TOKEN"
        ],
        [
          "GOOGLE_APPLICATION_CREDENTIALS"
        ]
      ],
      "sample_calls": [
        {
          "name": "gdrive_get_folder_metadata",
          "arguments": {
            "folder_id": "${ENV:GOOGLE_DRIVE_TEST_FOLDER_ID}"
          }
        },
        {
          "name": "gdrive_list_files",
          "arguments": {
            "folder_id": "${ENV:GOOGLE_DRIVE_TEST_FOLDER_ID}",
            "page_size": 10
          }
        },
        {
          "name": "gdrive_write_text_file",
          "arguments": {
            "folder_id": "${ENV:GOOGLE_DRIVE_TEST_FOLDER_ID}",
            "name": "rope-gdrive-capture-{run_stamp}.txt",
            "content": "ROPE Google Drive MCP capture write test {run_stamp}"
          }
        }
      ]
    },
    {
      "server_id": "playwright_browser",
      "category": "browser_public_web",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser",
        "chrome",
        "--output-mode",
        "stdout"
      ],
      "sample_calls": [
        {
          "name": "browser_navigate",
          "arguments": {
            "url": "https://example.com"
          }
        },
        {
          "name": "browser_snapshot",
          "arguments": {}
        },
        {
          "name": "browser_network_requests",
          "arguments": {}
        },
        {
          "name": "browser_close",
          "arguments": {}
        }
      ]
    },
    {
      "server_id": "discord",
      "category": "same_org_message",
      "command": [
        ".venv/bin/python",
        "scripts/discord_mcp_adapter.py"
      ],
      "requires_env": [
        "DISCORD_BOT_TOKEN",
        "DISCORD_CHANNEL_ID"
      ],
      "sample_calls": [
        {
          "name": "discord_get_channel",
          "arguments": {
            "channel_id": "${ENV:DISCORD_CHANNEL_ID}"
          }
        },
        {
          "name": "discord_list_messages",
          "arguments": {
            "channel_id": "${ENV:DISCORD_CHANNEL_ID}",
            "limit": 5
          }
        },
        {
          "name": "discord_post_message",
          "arguments": {
            "channel_id": "${ENV:DISCORD_CHANNEL_ID}",
            "content": "ROPE MCP capture Discord write test {run_stamp}"
          }
        }
      ]
    }
  ]
}
